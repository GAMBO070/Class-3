from gpiozero import DistanceSensor, LED
from time import sleep

sensor = DistanceSensor(echo=24, trigger=23)
alarm_led = LED(17)

print("=========================================")
print("  BT-HUB SENSOR CALIBRATION MODULE READY ")
print("=========================================")
print("Scanning for intruders...")

while True:
    # 2. Sensor Calibration / Data Parsing
    # gpiozero returns distance in meters (0.0 to 1.0). Multiply by 100 for centimeters.
    raw_distance_cm = sensor.distance * 100
    
    # Calibrate by rounding to 1 decimal place to stop terminal text jitter
    calibrated_distance = round(raw_distance_cm, 1)
    
    # 3. Terminal Monitoring (Shows the students live telemetry data)
    print(f"Current Distance: {calibrated_distance} cm", end="\r")
    
    # 4. If/Else Threshold Logic
    if calibrated_distance < 15.0:
        print(f"\n INTRUDER ALERT! Object detected at {calibrated_distance} cm!")
        alarm_led.on()  # Turn on the alert indicator
        sleep(0.5)      # Keep the alarm visible
    else:
        alarm_led.off() # Clear the alarm when the path is free
        
    sleep(0.1) # Small delay to give the processor breathing room
